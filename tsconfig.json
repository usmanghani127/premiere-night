{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "skipLibCheck": true,
    "baseUrl": "src",
    "paths": {
      "@hooks/*": ["hooks/*"],
      "@common/*": ["common/*"],
      "@screens/*": ["screens/*"],
      "@services/*": ["services/*"],
      "@theme/*": ["theme/*"],
      "@navigation/*": ["navigation/*"],
      "@localization/*": ["localization/*"]
    }
  }
}
